    {
      "name": "Resume Management",
      "item": [
        {
          "name": "Upload Resume",
          "event": [
            {
              "listen": "test",
              "script": {
                "exec": [
                  "if (pm.response.code === 201) {",
                  "    const response = pm.response.json();",
                  "    pm.collectionVariables.set('resume_id', response.resume.id);",
                  "    console.log('Resume ID saved:', response.resume.id);",
                  "}"
                ]
              }
            }
          ],
          "request": {
            "method": "POST",
            "header": [],
            "body": {
              "mode": "formdata",
              "formdata": [
                {
                  "key": "resume",
                  "type": "file",
                  "src": "/path/to/your/resume.pdf",
                  "description": "Upload a PDF or DOCX resume file"
                }
              ]
            },
            "url": {
              "raw": "{{base_url}}/api/resumes/upload",
              "host": ["{{base_url}}"],
              "path": ["api", "resume", "upload"]
            }
          },
          "response": []
        },
        {
          "name": "Get All Resumes",
          "request": {
            "method": "GET",
            "header": [],
            "url": {
              "raw": "{{base_url}}/api/resumes?page=1&limit=10",
              "host": ["{{base_url}}"],
              "path": ["api", "resume"],
              "query": [
                {
                  "key": "page",
                  "value": "1"
                },
                {
                  "key": "limit",
                  "value": "10"
                }
              ]
            }
          },
          "response": []
        },
        {
          "name": "Get Resume by ID",
          "request": {
            "method": "GET",
            "header": [],
            "url": {
              "raw": "{{base_url}}/api/resumes/{{resume_id}}",
              "host": ["{{base_url}}"],
              "path": ["api", "resume", "{{resume_id}}"]
            }
          },
          "response": []
        },
        {
          "name": "Get Resume Text",
          "request": {
            "method": "GET",
            "header": [],
            "url": {
              "raw": "{{base_url}}/api/resumes/{{resume_id}}/text",
              "host": ["{{base_url}}"],
              "path": ["api", "resume", "{{resume_id}}", "text"]
            }
          },
          "response": []
        },
        {
          "name": "Analyze Resume",
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"job_description\": \"We are looking for a Senior Software Engineer with 5+ years of experience in Node.js, React, and PostgreSQL. The ideal candidate should have experience with AI/ML integration, microservices architecture, and cloud deployment. Responsibilities include developing scalable web applications, mentoring junior developers, and collaborating with cross-functional teams.\",\n  \"target_role\": \"Senior Software Engineer\",\n  \"target_company\": \"Tech Corp\"\n}"
            },
            "url": {
              "raw": "{{base_url}}/api/resumes/analyze?resume_id={{resume_id}}",
              "host": ["{{base_url}}"],
              "path": ["api", "resume", "analyze"],
              "query": [
                {
                  "key": "resume_id",
                  "value": "{{resume_id}}"
                }
              ]
            }
          },
          "response": []
        },
        {
          "name": "Optimize Resume (Pro Only)",
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"job_description\": \"We are looking for a Senior Software Engineer with 5+ years of experience in Node.js, React, and PostgreSQL. The ideal candidate should have experience with AI/ML integration, microservices architecture, and cloud deployment.\",\n  \"target_role\": \"Senior Software Engineer\"\n}"
            },
            "url": {
              "raw": "{{base_url}}/api/resumes/optimize?resume_id={{resume_id}}",
              "host": ["{{base_url}}"],
              "path": ["api", "resume", "optimize"],
              "query": [
                {
                  "key": "resume_id",
                  "value": "{{resume_id}}"
                }
              ]
            }
          },
          "response": []
        },
        {
          "name": "Delete Resume",
          "request": {
            "method": "DELETE",
            "header": [],
            "url": {
              "raw": "{{base_url}}/api/resumes/{{resume_id}}",
              "host": ["{{base_url}}"],
              "path": ["api", "resume", "{{resume_id}}"]
            }
          },
          "response": []
        }
      ]
