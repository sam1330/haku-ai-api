{
  "name": "resume-ai-backend",
  "version": "1.0.0",
  "description": "AI-Powered Resume & Job Application Assistant Backend",
  "main": "src/server.js",
  "scripts": {
    "dev": "tsx watch src/server.js",
    "build": "tsc",
    "start": "node dist/server.js",
    "test": "jest --runInBand --forceExit",
    "test:db": "node scripts/test-db.js",
    "migrate": "knex migrate:latest",
    "seed": "knex seed:run",
    "prepare": "husky"
  },
  "keywords": [
    "resume",
    "ai",
    "job-application",
    "cover-letter"
  ],
  "author": "Your Name",
  "license": "MIT",
  "dependencies": {
    "@aws-sdk/client-s3": "^3.1030.0",
    "@google/genai": "^2.10.0",
    "@lemonsqueezy/lemonsqueezy.js": "^4.0.0",
    "@sentry/node": "^10.49.0",
    "@sentry/profiling-node": "^10.49.0",
    "bcryptjs": "^2.4.3",
    "compression": "^1.7.4",
    "cookie-parser": "^1.4.7",
    "cors": "^2.8.5",
    "dotenv": "^16.3.1",
    "express": "^4.18.2",
    "express-rate-limit": "^7.1.5",
    "helmet": "^7.1.0",
    "joi": "^17.11.0",
    "jsonwebtoken": "^9.0.2",
    "knex": "^3.0.1",
    "mammoth": "^1.6.0",
    "morgan": "^1.10.0",
    "multer": "^2.1.1",
    "pdf-parse": "^2.4.5",
    "pg": "^8.11.3",
    "playwright": "^1.59.1",
    "resend": "^6.10.0",
    "supertest": "^7.2.2",
    "uuid": "^9.0.1",
    "zod": "^4.4.3"
  },
  "devDependencies": {
    "@types/bcryptjs": "^2.4.6",
    "@types/compression": "^1.8.1",
    "@types/cookie-parser": "^1.4.10",
    "@types/cors": "^2.8.19",
    "@types/express": "^5.0.6",
    "@types/jest": "^30.0.0",
    "@types/jsonwebtoken": "^9.0.10",
    "@types/morgan": "^1.9.10",
    "@types/multer": "^2.1.0",
    "@types/node": "^26.0.1",
    "eslint": "^8.57.0",
    "eslint-config-prettier": "^10.1.8",
    "jest": "^29.7.0",
    "nodemon": "^3.0.2",
    "tsx": "^4.22.4",
    "typescript": "^6.0.3"
  },
  "engines": {
    "node": ">=18.0.0"
  },
  "jest": {
    "testEnvironment": "node",
    "setupFiles": [
      "<rootDir>/test/jestSetup.js"
    ],
    "testTimeout": 30000,
    "clearMocks": true
  },
  "lint-staged": {
    "*.js": [
      "npx eslint --fix",
      "npx prettier --write"
    ],
    "**/*": "npx prettier --write --ignore-unknown"
  }
}
